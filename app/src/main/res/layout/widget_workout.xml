<?xml version="1.0" encoding="utf-8"?>
<!-- Figma widget small. Everything stays 16dp inside the card; the card is a fill-only rounded background. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center_vertical" android:padding="16dp"
    android:background="@drawable/move60_widget_card">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:maxLines="1" android:ellipsize="end"
            android:textColor="@color/move60_text" android:textStyle="bold" android:textSize="16sp" android:text="운동 대기"/>
        <TextView android:id="@+id/widget_chip" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:paddingStart="10dp" android:paddingEnd="10dp"
            android:paddingTop="4dp" android:paddingBottom="4dp" android:maxLines="1"
            android:background="@drawable/bg_widget_chip_muted" android:textColor="@color/move60_text"
            android:textStyle="bold" android:textSize="12sp" android:text="대기"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:gravity="bottom" android:orientation="horizontal">
        <Chronometer android:id="@+id/widget_timer" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:maxLines="1" android:textColor="@color/move60_text"
            android:textStyle="bold" android:textSize="28sp" android:format="%s"/>
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:gravity="center_vertical|end" android:orientation="horizontal">
            <ImageView android:id="@+id/widget_heart_icon" android:layout_width="16dp" android:layout_height="16dp"
                android:src="@drawable/ic_widget_heart" android:importantForAccessibility="no" android:visibility="gone"/>
            <TextView android:id="@+id/widget_heart_value" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:maxLines="1" android:textColor="@color/move60_text"
                android:textStyle="bold" android:textSize="16sp" android:visibility="gone"/>
            <TextView android:id="@+id/widget_heart_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="6dp" android:maxLines="1" android:textColor="@color/move60_text_muted"
                android:textSize="12sp" android:visibility="gone"/>
            <TextView android:id="@+id/widget_heart_empty" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:textColor="@color/move60_text_muted" android:textSize="12sp" android:text="연결 대기"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
