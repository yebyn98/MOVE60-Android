<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root" android:layout_width="match_parent"
    android:layout_height="match_parent" android:orientation="vertical"
    android:gravity="center_vertical" android:padding="16dp"
    android:background="#17202B">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#B4F56E"
        android:textStyle="bold" android:textSize="17sp" android:text="MOVE60"/>
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#FFFFFF"
        android:textSize="13sp" android:text="운동 대기"/>
    <Chronometer android:id="@+id/widget_timer" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="#FFFFFF"
        android:textStyle="bold" android:textSize="25sp" android:format="%s"/>
</LinearLayout>
